# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rate Limiter (Upstash Redis)
REDIS_URL=rediss://default:your_upstash_password@your-redis-instance.upstash.io:6379

# GitHub Telemetry
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Transactional Email Dispatch (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Merchant of Record (Lemon Squeezy)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_signing_secret
LEMON_SQUEEZY_VARIANT_ID=your_lemon_squeezy_variant_id_here
